###############################################################################
# KasirKita — contoh konfigurasi
#
# Salin menjadi .env lalu sesuaikan:
#   cp .env.example .env && php artisan key:generate
#
# Berkas ini memuat DUA skenario:
#   (A) Lokal  — XAMPP/Laragon + MySQL      -> dipakai apa adanya
#   (B) Daring — Vercel + Supabase          -> lihat blok bertanda [VERCEL]
# Panduan lengkap: docs/11-deploy-supabase-vercel.md
###############################################################################

APP_NAME=KasirKita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# AKUN AWAL
#------------------------------------------------------------------------------
# Akun pemilik usaha yang dibuat oleh `php artisan db:seed`.
# Isi ADMIN_PASSWORD sebelum seeding; bila dikosongkan, seeder membuat
# password acak dan mencetaknya sekali ke layar.
ADMIN_NAME="Pemilik Usaha"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

#------------------------------------------------------------------------------
# (A) DATABASE LOKAL — MySQL / MariaDB (XAMPP)
#------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kasirkita
DB_USERNAME=root
DB_PASSWORD=

#------------------------------------------------------------------------------
# (B) [VERCEL] DATABASE SUPABASE — PostgreSQL
#
# Ambil nilainya di Supabase: Project Settings > Database > Connection string.
# Gunakan "Session pooler" (port 5432) ATAU "Transaction pooler" (port 6543).
# Jika memakai port 6543, WAJIB set DB_EMULATE_PREPARES=true.
#
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_EMULATE_PREPARES=false
#------------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

#------------------------------------------------------------------------------
# PENYIMPANAN BERKAS (foto menu & foto pengguna)
#
# Lokal  : UPLOAD_DISK=public   -> storage/app/public (butuh `php artisan storage:link`)
# Vercel : UPLOAD_DISK=supabase -> Supabase Storage, karena sistem berkas
#                                  di Vercel bersifat baca-saja.
#------------------------------------------------------------------------------
FILESYSTEM_DISK=local
UPLOAD_DISK=public

# [VERCEL] Supabase Storage (S3-compatible)
# Supabase: Project Settings > Storage > S3 Connection
# SUPABASE_S3_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/storage/v1/s3
# SUPABASE_S3_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/storage/v1/object/public/kasirkita
# SUPABASE_S3_REGION=ap-southeast-1
# SUPABASE_S3_BUCKET=kasirkita
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="kasirkita@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
